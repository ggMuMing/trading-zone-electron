{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-zone.local/contracts/market_sync.day.request.json",
  "title": "MarketSyncDayRequest",
  "description": "Params for method data.sync.market_day",
  "type": "object",
  "required": ["token", "trade_date"],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1
    },
    "trade_date": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    }
  },
  "additionalProperties": false
}
