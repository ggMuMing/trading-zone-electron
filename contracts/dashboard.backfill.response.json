{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-zone.local/contracts/dashboard.backfill.response.json",
  "title": "DashboardBackfillResponse",
  "description": "Result for method data.sync.dashboard_backfill",
  "type": "object",
  "required": [
    "start_date",
    "end_date",
    "index_count",
    "margin_count",
    "limit_count",
    "index_fetched",
    "margin_fetched",
    "limit_days"
  ],
  "properties": {
    "start_date": { "type": "string", "pattern": "^[0-9]{8}$" },
    "end_date": { "type": "string", "pattern": "^[0-9]{8}$" },
    "index_count": { "type": "integer", "minimum": 0 },
    "margin_count": { "type": "integer", "minimum": 0 },
    "limit_count": { "type": "integer", "minimum": 0 },
    "index_fetched": { "type": "boolean" },
    "margin_fetched": { "type": "boolean" },
    "limit_days": { "type": "integer", "minimum": 0 },
    "error": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
