{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-zone.local/contracts/market_sync.plan.response.json",
  "title": "MarketSyncPlanResponse",
  "description": "Result for method data.sync.market_plan",
  "type": "object",
  "required": [
    "start_date",
    "end_date",
    "trade_dates",
    "complete_dates",
    "pending_dates",
    "total_days",
    "complete_count",
    "pending_count"
  ],
  "properties": {
    "start_date": { "type": "string", "pattern": "^[0-9]{8}$" },
    "end_date": { "type": "string", "pattern": "^[0-9]{8}$" },
    "trade_dates": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]{8}$" }
    },
    "complete_dates": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]{8}$" }
    },
    "pending_dates": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]{8}$" }
    },
    "total_days": { "type": "integer", "minimum": 0 },
    "complete_count": { "type": "integer", "minimum": 0 },
    "pending_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
