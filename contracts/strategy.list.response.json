{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-zone.local/contracts/strategy.list.response.json",
  "title": "StrategyListResponse",
  "description": "Result for method strategy.list",
  "type": "object",
  "required": ["strategies"],
