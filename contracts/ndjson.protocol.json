{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-zone.local/contracts/ndjson.protocol.json",
  "title": "PythonWorkerNdjsonProtocol",
  "description": "Main ↔ Python worker line protocol (one JSON object per line).",
  "oneOf": [
    {
      "title": "Ready",
      "type": "object",
      "required": ["type", "imports", "python"],
      "properties": {
        "type": { "const": "ready" },
        "imports": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "python": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "title": "Request",
      "type": "object",
      "required": ["id", "method"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    {
      "title": "Response",
      "type": "object",
      "required": ["id", "ok"],
      "properties": {
        "id": { "type": "string" },
        "ok": { "type": "boolean" },
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
