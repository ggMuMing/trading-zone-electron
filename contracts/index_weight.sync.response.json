{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IndexWeightSyncResult",
  "type": "object",
  "required": ["updated_count", "skipped_count", "empty_count", "as_of_dates", "errors"],
  "additionalProperties": false,
  "properties": {
    "updated_count": { "type": "integer", "minimum": 0 },
    "skipped_count": { "type": "integer", "minimum": 0 },
    "empty_count": { "type": "integer", "minimum": 0 },
    "as_of_dates": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 8, "maxLength": 8 }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
